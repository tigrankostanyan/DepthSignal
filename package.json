{
  "name": "myscreener",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env DOTENV_DISABLE=1 tsx server/server.ts",
    "build": "esbuild server/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "build:web": "npm --prefix web run build",
    "build:all": "npm run build && npm run build:web",
    "start:web": "npm --prefix web run start",
    "start:all": "node scripts/start-prod.js",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "test": "tsx server/tests/runAllTests.ts",
    "test:domain": "tsx server/tests/runStandaloneTests.ts",
    "test:comprehensive": "tsx server/tests/comprehensiveRuntimeVerification.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.3",
    "nodemon": "^3.1.14",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sequelize": "^6.37.8",
    "stripe": "^22.5.0",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^13.0.3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "sql.js": "^1.14.2",
    "sqlite3": "^6.0.1",
    "tailwindcss": "^4.1.14",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
