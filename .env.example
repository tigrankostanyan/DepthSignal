# MyScreener — environment template
# Copy to server/.env and fill in real values. Never commit real secrets.

# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3002
LOG_LEVEL=info

# ── Security (REQUIRED) ────────────────────────────────────────────────────────
# Must be a strong random value of at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The API refuses to start in production without it.
JWT_SECRET=
# Opt-in ONLY for local development. Ignored when NODE_ENV=production.
ALLOW_DEV_ACCESS_BYPASS=false

# ── Domains / CORS ─────────────────────────────────────────────────────────────
APP_DOMAIN=localhost
API_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3001

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── MySQL (Sequelize) ──────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=quantscreen_db
MYSQL_POOL_MAX=20
MYSQL_POOL_MIN=2
MYSQL_LOGGING=false

# ── Redis (optional — in-memory fallback is used when disabled) ────────────────
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=quantscreen
REDIS_WALL_TTL_SECONDS=300
REDIS_TICKER_TTL_SECONDS=30
REDIS_ORDERBOOK_TTL_SECONDS=10
REDIS_TRADE_TTL_SECONDS=60

# ── Manual QR payment (replaces gateway checkout) ──────────────────────────────
MANUAL_PAYMENT_QR_VALUE=
MANUAL_PAYMENT_QR_IMAGE_URL=
MANUAL_PAYMENT_INSTRUCTIONS=
MANUAL_PAYMENT_RECIPIENT=
MANUAL_PAYMENT_NETWORK=

# ── Telegram notifications ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Email notifications (SMTP) ─────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
WEBHOOK_SIGNING_SECRET=

# ── Stock market data providers (optional) ─────────────────────────────────────
FINNHUB_API_KEY=
POLYGON_API_KEY=

# ── Legacy Stripe / Binance Pay (unused by the manual QR flow) ─────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ADVANCED_PRICE_ID=
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=
BINANCE_PAY_API_BASE=https://bpay.binanceapi.com
BINANCE_PAY_WEBHOOK_URL=
BINANCE_PAY_WEBHOOK_PUBLIC_KEY=

# ── Docker Compose only (read by docker-compose.yml, not by the app code) ─────
# MySQL container root password and the dedicated app DB user the compose stack
# provisions. Dev/standalone setups keep using MYSQL_USER/MYSQL_PASSWORD above.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_APP_USER=myscreener
MYSQL_APP_PASSWORD=change-me

